# Hourglass configuration — /etc/hourglass.env
#
# This file is created automatically on package install with a generated
# password (see postinstall.sh) and printed to the console. Edit freely;
# the service picks changes up on `systemctl restart hourglass`.

# Bind address. 0.0.0.0 exposes the web UI on all interfaces so it can be
# reached from other machines (e.g. http://hourglass.local:8080). Requires
# HOURGLASS_AUTH_USER/HOURGLASS_AUTH_PASS below — Hourglass refuses to
# start unauthenticated on a non-loopback bind.
HOURGLASS_BIND=0.0.0.0:8080

# Credentials for the web UI (HTTP Basic Auth).
HOURGLASS_AUTH_USER=admin
HOURGLASS_AUTH_PASS=__HOURGLASS_PASSWORD__

# Advertise the web UI on the LAN via mDNS (Bonjour) so
# http://hourglass.local:8080 resolves from any device on the network.
# Set to 0 to disable. Only takes effect with a non-loopback HOURGLASS_BIND.
HOURGLASS_MDNS=1

# mDNS hostname (the "hourglass" in hourglass.local). Change with caution —
# the old name may stay cached on other devices for a while.
# HOURGLASS_MDNS_NAME=hourglass
